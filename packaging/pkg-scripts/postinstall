#!/bin/bash
# Apple's Installer runs this after the atomic bundle upgrade succeeds.
# Launch into the logged-in user's session, never as root.
console_user=$(/usr/bin/stat -f '%Su' /dev/console)
console_uid=$(/usr/bin/id -u "$console_user" 2>/dev/null)
case "$console_uid" in ''|*[!0-9]*) exit 0 ;; esac
if [ "$console_uid" -ge 501 ] && [ -d /Applications/RabbitDesktop.app ]; then
  /bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" /usr/bin/open /Applications/RabbitDesktop.app >/dev/null 2>&1 || true
fi
exit 0
